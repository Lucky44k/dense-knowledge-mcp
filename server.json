{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Lucky44k/dense-knowledge-mcp",
  "title": "Dense Knowledge",
  "description": "Local-first MCP memory server for persistent LLM knowledge with BM25 retrieval.",
  "repository": {
    "url": "https://github.com/Lucky44k/dense-knowledge-mcp",
    "source": "github",
    "id": "1316509848"
  },
  "version": "1.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "dense-knowledge-mcp",
      "version": "1.2.0",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "named",
          "name": "--root",
          "description": "Directory containing MMP knowledge packages.",
          "format": "filepath",
          "isRequired": false,
          "placeholder": "/absolute/path/to/memory"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
